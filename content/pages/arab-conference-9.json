</figure>\n<figure><img src=\"@media/pg/02e9a5f95f153ff8.webp\" alt=\"WhatsApp Image 2022-11-23 at 5.17.04 AM (2)\" width=\"960\" height=\"720\"></figure>\n<figure><img src=\"@media/pg/c037cd7c229c2817.webp\" alt=\"WhatsApp Image 2022-11-23 at 5.14.55 AM\" width=\"960\" height=\"638\"></figure>\n<figure><img src=\"@media/pg/a18a00f1ac4924e4.webp\" alt=\"WhatsApp Image 2022-11-23 at 5.14.54 AM\" width=\"960\" height=\"638\"></figure>\n<figure><img src=\"@media/pg/f542de53b7dbc424.webp\" alt=\"WhatsApp Image 2022-11-23 at 5.14.33 AM (1)\" width=\"960\" height=\"720\"></figure>\n<p><strong>الاتحاد</strong> <strong>العربي</strong> <strong>لعلوم</strong> <strong>الفضاء</strong> <strong>والفلك</strong></p>\n<p><strong>بالتعاون</strong> <strong>مع</strong></p>\n<p><strong>وزارة</strong> <strong>التعليم</strong> <strong>العالي</strong> <strong>والبحث</strong> <strong>العلمي</strong> <strong>ووزارة</strong> <strong>العلوم</strong> <strong>والتقانة</strong></p>\n<p><strong>واللجنة</strong> <strong>الوطنية</strong> <strong>للتربية</strong> <strong>والعلم</strong> <strong>والثقافة</strong></p>\n<p><strong>وبمشاركة</strong> <strong>من</strong> </p>\n<p><strong>المنظمة</strong> <strong>الإسلامية</strong> <strong>للتربية</strong> <strong>والعلوم</strong> <strong>والثقافة</strong></p>\n<p><strong>وبمناسبة</strong> <strong>السنة</strong> <strong>الفلكية</strong> <strong>الدولية</strong></p>\n<p><strong>وبرعاية</strong> <strong>كريمة</strong> <strong>من</strong> <strong>فخامة</strong> <strong>نائب</strong> <strong>رئيس</strong> <strong>جمهورية</strong> <strong>السودان</strong></p>\n<p><strong>الأستاذ</strong> / <strong>علي</strong> <strong>عثمان</strong> <strong>محمد</strong> <strong>طه</strong></p>\n<p><strong>يعقد</strong></p>\n<p><strong>المؤتمر</strong> <strong>العربي</strong> <strong>التاسع</strong> <strong>لعلوم</strong> <strong>الفضاء</strong> <strong>والفلك</strong> <strong>تحت</strong> <strong>شعار</strong></p>\n<p><strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>وتقاناتها</strong> <strong>في</strong> <strong>خدمة</strong> <strong>المجتمعات</strong> <strong>العربية</strong> <strong>والإسلامية</strong></p>\n<p><strong>١٧</strong>–<strong>١٩</strong> <strong>نوفمبر</strong> / <strong>تشرين</strong> <strong>الثاني</strong> <strong>٢٠٠٩</strong> <strong>م</strong></p>\n<ol>\n<li><strong>متابعة</strong> <strong>إنجازات</strong> <strong>العلماء</strong> <strong>والباحثين</strong> <strong>و</strong> <strong>إسهاماتهم</strong> <strong>العلمية</strong> <strong>في</strong> <strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>والجو</strong> <strong>وما</strong> <strong>أنجزوه</strong> <strong>داخل</strong> <strong>الوطن</strong> <strong>العربي</strong> <strong>أو</strong> <strong>خارجه،</strong> <strong>وذلك</strong> <strong>مواصلة</strong> <strong>لعقد</strong> <strong>سلسلة</strong> <strong>المؤتمرات</strong> <strong>العربية</strong> <strong>في</strong> <strong>مجالات</strong> <strong>هذه</strong> <strong>العلوم</strong>.</li>\n<li><strong>تعزيز</strong> <strong>أواصر</strong> <strong>التعاون</strong> <strong>العلمي</strong> <strong>والثقافي</strong> <strong>بين</strong> <strong>العلماء</strong> <strong>والباحثين</strong> <strong>العرب</strong> <strong>وكذلك</strong> <strong>المهتمين</strong> <strong>في</strong> <strong>مجال</strong> <strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء،</strong> <strong>وتطوير</strong> <strong>إنجاز</strong> <strong>الأبحاث</strong> <strong>والمشروعات</strong> <strong>المشتركة</strong> <strong>في</strong> <strong>تخصصات</strong> <strong>هذه</strong> <strong>العلوم</strong> <strong>وفتح</strong> <strong>المزيد</strong> <strong>من</strong> <strong>قنوات</strong> <strong>التفاعل</strong> <strong>بين</strong> <strong>عدد</strong> <strong>منهم</strong> <strong>عربياً</strong> <strong>وعالمياً</strong>. </li>\n<li><strong>مشاركة</strong> <strong>المجتمع</strong> <strong>العلمي</strong> <strong>الدولي</strong> <strong>بالاحتفال</strong> <strong>بالسنة</strong> <strong>الدولية</strong> <strong>للفلك</strong> (LAY2009) <strong>وذلك</strong> <strong>لمناقشة</strong> <strong>الأبحاث</strong> <strong>والمشاركة</strong> <strong>في</strong> <strong>الأنشطة</strong> <strong>التثقيفية</strong> <strong>في</strong> <strong>مجال</strong> <strong>علوم</strong> <strong>الفلك</strong> <strong>في</strong> <strong>نطاق</strong> <strong>عضوية</strong> <strong>الاتحاد</strong> <strong>العربي</strong>.</li>\n<li><strong>توظيف</strong> <strong>مناسبة</strong> <strong>هذا</strong> <strong>اللقاء</strong> <strong>العربي</strong> <strong>العلمي</strong> <strong>لعقد</strong> <strong>الاجتماع</strong> <strong>السابع</strong> <strong>للهيئة</strong> <strong>العمومية</strong> <strong>للاتحاد</strong> <strong>العربي</strong> <strong>لعلوم</strong> <strong>الفضاء</strong> <strong>والفلك،</strong> <strong>وذلك</strong> <strong>لمناقشة</strong> <strong>التقارير</strong> <strong>العلمية</strong> <strong>والإدارية</strong> <strong>والمالية</strong> <strong>لنشاطات</strong> <strong>الاتحاد</strong> <strong>منذ</strong> <strong>تأسيسه</strong> <strong>في</strong> <strong>آب</strong>/<strong>أغسطس</strong> <strong>١٩٩٨</strong> <strong>ومناقشة</strong> <strong>خططه</strong> <strong>الحالية</strong> <strong>والمستقبلية</strong>.</li>\n</ol>\n<p><strong>محاور</strong> <strong>المؤتمر</strong></p>\n<ol>\n<li><strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>في</strong> <strong>الوطن</strong> <strong>العربي</strong> <strong>الحديث</strong> </li>\n</ol>\n<p> <strong>أ</strong> – <strong>إنجازات</strong> <strong>الشباب</strong> <strong>وهواة</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>العرب</strong> <strong>المحدثين</strong></p>\n<p> <strong>ب</strong> – <strong>تدريس</strong> <strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>وتعليمها</strong> (<strong>المدارس</strong> <strong>والجامعات</strong>)</p>\n<p> <strong>ت</strong> – <strong>نشاطات</strong> <strong>معاهد</strong> <strong>ومراكز</strong> <strong>علوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>العربية</strong> <strong>وتطلعاتها</strong> <strong>المستقبلية</strong></p>\n<p> <strong>ج</strong> – <strong>البحث</strong> <strong>العلمي</strong> <strong>في</strong> <strong>مجالات</strong> <strong>الفيزياء</strong> <strong>وعلوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong></p>\n<p>2. <strong>إسهامات</strong> <strong>العرب</strong> <strong>والمسلمين</strong> <strong>في</strong> <strong>العلوم</strong> <strong>الكونية</strong> <strong>وعلم</strong> <strong>الفلك</strong> <strong>على</strong> <strong>وجه</strong> <strong>الخصوص</strong></p>\n<p>3. <strong>علوم</strong> <strong>الجو</strong> <strong>والفضاء</strong> <strong>وتطبيقاتها</strong></p>\n<p>4. <strong>الفلك</strong> <strong>والفيزياء</strong> <strong>الفلكية</strong></p>\n<p> <strong>أ</strong> – <strong>الترويج</strong> <strong>للمعرفة</strong> <strong>الكونية</strong> <strong>واشاعة</strong> <strong>الوعي</strong> <strong>بعلوم</strong> <strong>الفلك</strong> <strong>والفضاء</strong> <strong>في</strong> <strong>المجتمع</strong></p>\n<p> <strong>ب</strong> – <strong>اخلاقيات</strong> <strong>علوم</strong> <strong>الفضاء</strong> <strong>والاتصالات</strong> <strong>و</strong> <strong>أبحاثها</strong></p>\n<p> <strong>ج</strong> – <strong>مناقشات</strong> <strong>إدارية</strong> <strong>للاتحاد</strong> <strong>العربي</strong> <strong>لعلوم</strong> <strong>الفضاء</strong> <strong>والفلك</strong></p>\n\n<h2><a href=\"https://auass.com/wp-content/uploads/2022/11/توصيات-المؤتمر-العري-التاسع-الخرطوم.pdf\">عرض التوصيات </a></h2>"
